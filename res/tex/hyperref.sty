% hyperref: the names \autoref puts before a number ("Equation 1", "section 2"), which hyperref keeps as \equationautorefname and
% the like. Only the names are here; \autoref itself is the engine's, and the links, \hypersetup and the other options are not drawn.
\gmdeclare{autoref}{equation}{Equation}
\gmdeclare{autoref}{figure}{Figure}
\gmdeclare{autoref}{table}{Table}
\gmdeclare{autoref}{section}{section}
\gmdeclare{autoref}{subsection}{subsection}
\gmdeclare{autoref}{subsubsection}{subsubsection}
\gmdeclare{autoref}{paragraph}{paragraph}
\gmdeclare{autoref}{subparagraph}{subparagraph}
