\ProvidesPackage{xfrac}[2026/10/11 xfrac: \sfrac]
% As LaTeX sets it at 10pt: the numerator and the denominator in script size, the numerator 2.24pt up, the slash at
% the size of the text with the denominator 1.1pt back into it.
\newcommand{\sfrac}[2]{\raisebox{.224em}{\numstyle{#1}}\nokern\mathslash\kern-.11em\dnomstyle{#2}}
