\ProvidesPackage{esdiff}[2026/10/12 esdiff: the notation of derivatives]
% Written from the package's documentation: \diff{f}{x} and \diffp{f}{x}, an
% order in [n], a star and a third argument for a derivative evaluated at a
% point, and \diffp{f}{xy} (up to three variables) for a mixed partial. A
% derivative is set in display size wherever it is, as the package does. The
% display, text and spacing options are accepted and not used.
\DeclareOption{roman}{\def\gm@esd{\mathrm{d}}}
\DeclareOption{italic}{\def\gm@esd{d}}
\DeclareOption*{}
\ExecuteOptions{roman}
\ProcessOptions\relax

\newcommand{\gm@q}{}
\newcommand{\gm@esstyle}[1]{\mathchoice{#1}{\displaystyle{#1}}{\scriptstyle{#1}}{\scriptstyle{#1}}}

% #1 the order or \NoValue, #2 d or \partial, #3 what is differentiated, #4 by what.
\newcommand{\gm@esfrac}[4]{%
  \IfNoValueTF{#1}{\frac{#2 #3}{#2 #4}}{\frac{#2^{#1}#3}{#2 #4^{#1}}}}

% The starred forms take one more argument, the point, which is read after them.
\NewDocumentCommand{\gm@esat}{ m m m m m }{%
  \gm@esstyle{\left(\gm@esfrac{#1}{#2}{#3}{#4}\right)_{\mkern-7mu #5}}}
\NewDocumentCommand{\diff}{ s o m m }{%
  \IfBooleanTF{#1}{\gm@esat{#2}{\gm@esd}{#3}{#4}}%
    {\gm@esstyle{\gm@esfrac{#2}{\gm@esd}{#3}{#4}}}}

% The variables of \diffp: one, two or three, each a single token.
\def\gm@espv#1#2#3#4\gm@end#5#6{%
  \ifx\gm@q#2\relax
    \gm@esfrac{#6}{\partial}{#5}{#1}%
  \else\ifx\gm@q#3\relax
    \frac{\partial^{2}#5}{\partial #1\partial #2}%
  \else
    \frac{\partial^{3}#5}{\partial #1\partial #2\partial #3}%
  \fi\fi}
\newcommand{\gm@espfrac}[3]{\gm@espv#3\gm@q\gm@q\gm@q\gm@end{#2}{#1}}

\NewDocumentCommand{\gm@espat}{ m m m m }{%
  \gm@esstyle{\left(\gm@espfrac{#1}{#2}{#3}\right)_{\mkern-7mu #4}}}
\NewDocumentCommand{\diffp}{ s o m m }{%
  \IfBooleanTF{#1}{\gm@espat{#2}{#3}{#4}}%
    {\gm@esstyle{\gm@espfrac{#2}{#3}{#4}}}}
